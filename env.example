# Local defaults (works with docker-compose)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://app:app@db:5432/app

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="Dev <dev@example.test>"

# Dev-only; override in production
BETTER_AUTH_SECRET=dev_only_change_me_but_at_least_32_chars_long

# Optional integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
